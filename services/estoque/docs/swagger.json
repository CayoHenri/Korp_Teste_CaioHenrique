    "definitions": {
        "dto.AtualizarProdutoRequest": {
            "type": "object",
            "required": [
                "descricao",
                "saldo",
                "valor"
            ],
            "properties": {
                "descricao": {
                    "type": "string",
                    "example": "TECLADO MECANICO RGB"
                },
                "saldo": {
                    "type": "integer",
                    "example": 20
                },
                "valor": {
                    "type": "number",
                    "example": 15990
                }
            }
        },
        "dto.CriarProdutoRequest": {
            "type": "object",
            "required": [
                "valor"
            ],
            "properties": {
                "codigo": {
                    "type": "string",
                    "example": "SKU-001"
                },
                "descricao": {
                    "type": "string",
                    "example": "TECLADO MECANICO"
                },
                "saldo": {
                    "type": "integer",
                    "example": 10
                },
                "valor": {
                    "type": "number",
                    "example": 15990
                }
            }
        },
        "dto.MovimentacaoResponse": {
            "type": "object",
            "properties": {
