                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "produtoId": {
                    "type": "string"
                },
                "quantidade": {
                    "type": "integer"
                },
                "referencia": {
                    "type": "string"
                },
                "tipo": {
                    "type": "string"
                }
            }
        },
        "dto.ProdutoResponse": {
            "type": "object",
            "properties": {
                "ativo": {
                    "type": "boolean"
                },
                "codigo": {
                    "type": "string"
                },
                "dataAtualizacao": {
                    "type": "string"
                },
                "dataCadastro": {
                    "type": "string"
                },
                "descricao": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "saldo": {
                    "type": "integer"
                },
                "valor": {
                    "type": "number"
                }
            }
        },
        "response.ErrorData": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string",
                    "example": "PRODUTO_NAO_ENCONTRADO"
                },
                "message": {
                    "type": "string",
                    "example": "produto nao encontrado"
