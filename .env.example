# Copie este arquivo para .env se quiser substituir os valores de desenvolvimento.

POSTGRES_DB=korp_db
POSTGRES_USER=korp
POSTGRES_PASSWORD=korp_dev_password
POSTGRES_PORT=5432

RABBITMQ_USER=korp
RABBITMQ_PASSWORD=korp_dev_password
RABBITMQ_VHOST=korp
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Estoque Service (execucao local, fora do Docker)
ESTOQUE_HTTP_PORT=8081
ESTOQUE_DATABASE_URL=postgres://korp:korp_dev_password@localhost:5432/korp_db?sslmode=disable
ESTOQUE_RABBITMQ_URL=amqp://korp:korp_dev_password@localhost:5672/korp

# Faturamento Service (execucao local, fora do Docker)
FATURAMENTO_HTTP_PORT=8082
FATURAMENTO_DATABASE_URL=postgres://korp:korp_dev_password@localhost:5432/korp_db?sslmode=disable
FATURAMENTO_ESTOQUE_BASE_URL=http://localhost:8081
FATURAMENTO_RABBITMQ_URL=amqp://korp:korp_dev_password@localhost:5672/korp
FATURAMENTO_OUTBOX_INTERVAL=2s
